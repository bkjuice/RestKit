<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RestKit</RootNamespace>
    <AssemblyName>RestKit</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not compiled in the legacy project either; preserved as-is. -->
    <Compile Remove="ResourceStatus.cs" />
  </ItemGroup>

  <!-- Packaging: major-version bump to 2.0.0. The net10.0 retarget dropped System.UriTemplate,
       ASP.NET Web API SelfHost, and JavaScriptSerializer-based JSON handling - real breaking changes
       for consumers, hence major rather than minor/patch.
       Uses SDK-style inline package metadata rather than RestKit.nuspec: a bare <NuspecFile> with no
       <files> section does NOT pick up this project's own build output by convention (confirmed - it
       produced a .nupkg with no lib\net10.0\RestKit.dll in it, NU5100). The metadata below mirrors
       RestKit.nuspec's content; that file is no longer referenced from the build but left on disk. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <PackageId>RestKit</PackageId>
    <Title>RestKit</Title>
    <Authors>Bruce Krakower</Authors>
    <Description>Using RestKit is as simple as 'representation = Resource.Json().Get(uri)', then 'representation.GetContentAsJson()'. You can therefore handle unexpected content. Variations exist for Xml and Text. For advanced scenarios, you have full control of serialization, a callback pipeline, and full access to the underlying HttpClient and HttpResponseMessage. Use of RestKit is mockable using the IHttpResource interface and/or by injecting a mock HttpMessageHandler into a stub.</Description>
    <PackageProjectUrl>https://github.com/bkjuice/RestKit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>REST;Http Client;JSON;XML;HTTP</PackageTags>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Faithful port of the old post-build staging step: copy the packed .nupkg/.snupkg into packageStaging\.
       Resolved relative to this project (not $(SolutionDir), which is only set when building via the .sln). -->
  <PropertyGroup>
    <PackageStagingDir>$(MSBuildProjectDirectory)\..\..\packageStaging\</PackageStagingDir>
  </PropertyGroup>

  <Target Name="StagePackages" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PackagesBuilt Include="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg;$(PackageOutputPath)$(PackageId).$(PackageVersion).snupkg" />
      <StaledPackages Include="$(PackageStagingDir)$(PackageId)*.nupkg;$(PackageStagingDir)$(PackageId)*.snupkg" />
    </ItemGroup>
    <Delete Files="@(StaledPackages)" ContinueOnError="true" />
    <Copy SourceFiles="@(PackagesBuilt)" DestinationFolder="$(PackageStagingDir)" ContinueOnError="true" />
  </Target>

</Project>
